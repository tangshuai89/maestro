{
  "name": "@maestro/common",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-package shared utilities for maestro (fuzzy keys, normalizers, etc.)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "opencc-js": "^1.4.1"
  },
  "devDependencies": {
    "typescript": "~5.5.4",
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
