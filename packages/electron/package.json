{
  "name": "@maestro/electron",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "predev": "node scripts/ensure-electron-dist.cjs",
    "dev": "tsc -p tsconfig.build.json && electron dist/main.js",
    "build": "node scripts/clean-dist.cjs dist && tsc -p tsconfig.build.json",
    "start": "electron dist/main.js",
    "gen-icons": "node scripts/gen-icons.cjs",
    "prepack": "node scripts/ensure-electron-dist.cjs",
    "pack": "node scripts/pack.cjs",
    "pack:verify": "bash scripts/verify-pack.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#8244344c33634d9323377c0d0fd1d9b7f9b69540",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "build": {
    "appId": "io.github.tangshuai89.maestro",
    "productName": "Maestro",
    "afterPack": "afterPack-vmp.cjs",
    "electronDist": "../../node_modules/electron/dist",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Spotify OAuth Callback",
        "schemes": [
          "maestro"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "icon": "build/icon.icns",
      "notarize": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "!dist/**/*.d.ts.map",
      "!dist/**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../renderer/dist",
        "to": "renderer"
      },
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "pack-server-deps/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "build",
        "to": "build"
      }
    ]
  }
}
