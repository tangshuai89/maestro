{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-cn-coding-plan/MiniMax-M3",
  "small_model": "deepseek/deepseek-v4-flash",
  "autoupdate": "notify",
  "instructions": [
    "AGENTS.md",
    "docs/figma-driven-frontend.md",
    "docs/qq-music-source.md",
    "docs/aether-theater-v4-spec.md",
    "docs/prototype-wiring-checklist.md"
  ],
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 65536
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "--ignore-unknown", "$FILE"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".json", ".md"]
    }
  },
  "lsp": {
    "typescript": {
      "command": ["npx", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {}
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GH_TOKEN}"
      }
    }
  },
  "plugin": [
    "./.opencode/plugin/auto-tick-tasks.ts"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node -e *": "allow",
      "node *": "allow",
      "bash scripts/*": "allow",
      "find packages/*": "allow",
      "lsof -ti:*": "allow",
      "xargs *": "allow",
      "curl *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "timeout * node *": "allow",
      "kill *": "deny"
    },
    "webfetch": "allow"
  }
}
