{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-cn-coding-plan/MiniMax-M3",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "--ignore-unknown", "$FILE"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".json", ".md"]
    }
  },
  "lsp": {
    "typescript": {
      "command": ["npx", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node -e *": "allow",
      "node *": "allow",
      "bash scripts/*": "allow",
      "find packages/*": "allow",
      "lsof -ti:*": "allow",
      "xargs *": "allow",
      "curl *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "timeout * node *": "allow",
      "kill *": "deny"
    },
    "webfetch": "allow"
  }
}
