{
  "name": "maestro",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal music player for Mac with QQ Music integration, inspired by Douban FM",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "cd packages/server && npm run start:dev",
    "dev:renderer": "cd packages/renderer && npm run dev",
    "dev:electron": "cd packages/electron && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:renderer\" \"sleep 3 && npm run dev:electron\"",
    "build:common": "cd packages/common && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:renderer": "cd packages/renderer && npm run build",
    "build:electron": "cd packages/electron && npm run build",
    "build": "npm run build:common && npm run build:server && npm run build:renderer && npm run build:electron",
    "lint": "bash scripts/lint.sh",
    "lint:renderer": "cd packages/renderer && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "bash scripts/test.sh"
  },
  "author": "tangshuai89",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript-language-server": "^5.3.0"
  }
}
