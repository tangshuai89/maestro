{
  "name": "maestro",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform music player (QQ / NetEase / Deezer / Spotify) with DeepSeek AI recommendations, built on Electron + React + NestJS",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "cd packages/server && npm run start:dev",
    "dev:renderer": "cd packages/renderer && npm run dev",
    "dev:electron": "cd packages/electron && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:renderer\" \"sleep 3 && npm run dev:electron\"",
    "build:common": "cd packages/common && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:renderer": "cd packages/renderer && npm run build",
    "build:electron": "cd packages/electron && npm run build",
    "build": "npm run build:common && npm run build:server && npm run build:renderer && npm run build:electron",
    "lint": "bash scripts/lint.sh",
    "lint:renderer": "cd packages/renderer && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run build:common",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:common",
    "test": "bash scripts/test.sh",
    "test:ci": "bash scripts/test.sh --ci && node scripts/figma-code-connect-validate.mjs && node scripts/figma-aether-v4-audit.mjs --self-test && node scripts/check-token-drift.mjs && node scripts/scan-hardcoded-colors.mjs --gate && node scripts/check-readme-i18n.mjs --self-test --gate && node scripts/figma-diff.test.mjs && node scripts/figma-diff.mjs --gate && node scripts/check-acceptance-evidence.mjs --self-test && node scripts/check-acceptance-evidence.mjs && node scripts/lib/lcov.js --self-test && node scripts/merge-lcov.js --self-test && node scripts/coverage-diff-gate.js --self-test && node scripts/collect-line-coverage-trust.js --self-test && node scripts/istanbul-to-lcov.js --self-test && node scripts/collect-browser-coverage.mjs --self-test && node packages/electron/scripts/pack.cjs --self-test",
    "test:coverage": "bash scripts/test.sh --coverage",
    "coverage:diff-gate": "node scripts/coverage-diff-gate.js",
    "test:i18n": "node scripts/check-readme-i18n.mjs --self-test --gate",
    "test:code-connect": "node scripts/figma-code-connect-validate.mjs",
    "figma:diff": "node scripts/figma-diff.mjs",
    "figma:diff:json": "node scripts/figma-diff.mjs --json",
    "figma:diff:gate": "node scripts/figma-diff.mjs --gate",
    "figma:test": "node scripts/figma-diff.test.mjs",
    "figma:diff:mutation": "node scripts/figma-diff.mutation.mjs",
    "test:code-connect:strict": "node scripts/figma-code-connect-validate.mjs --strict",
    "test:description": "node scripts/figma-aether-v4-audit-d6.mjs",
    "test:motion": "node scripts/figma-aether-v4-audit-d10.mjs",
    "tokens:check": "node scripts/check-token-drift.mjs",
    "tokens:check:json": "node scripts/check-token-drift.mjs --json",
    "tokens:export": "node scripts/figma-export-tokens.mjs scripts/figma-tokens-dump.json",
    "tokens:pull": "node scripts/figma-tokens-pull.mjs",
    "tokens:hardcoded": "node scripts/scan-hardcoded-colors.mjs",
    "tokens:hardcoded:gate": "node scripts/scan-hardcoded-colors.mjs --gate",
    "retrofit:analyze": "node scripts/figma-retrofit-analyze.mjs",
    "retrofit:fixture": "node scripts/figma-retrofit-fixture.mjs",
    "retrofit:plan": "node scripts/figma-retrofit-plan-to-plugin.mjs",
    "retrofit:typecheck": "node scripts/figma-retrofit-typecheck.mjs",
    "visual:serve": "cd packages/renderer && npx vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "visual:test": "npm run build:renderer && node scripts/run-playwright.mjs test --config playwright.config.mjs",
    "visual:baseline": "npm run build:renderer && node scripts/run-playwright.mjs test --config playwright.config.mjs --update-snapshots",
    "reco:eval": "cd packages/server && npx ts-node src/reco/eval-cli.ts",
    "reco:eval:genre": "cd packages/server && npx ts-node src/reco/eval-genre-cli.ts",
    "reco:eval:offline": "cd packages/server && npx ts-node src/reco/eval-offline-cli.ts",
    "reco:eval:sweep": "cd packages/server && npx ts-node src/reco/sweep-cli.ts",
    "e2e:server": "cd packages/server && npx ts-node src/e2e/e2e-server.ts",
    "e2e": "playwright test --config playwright.e2e.config.mjs",
    "coverage:browser": "node scripts/collect-browser-coverage.mjs"
  },
  "author": "tangshuai89",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^1.6.1",
    "c8": "^12.0.0",
    "concurrently": "^10.0.3",
    "happy-dom": "^15.11.7",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript-language-server": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json,md,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
